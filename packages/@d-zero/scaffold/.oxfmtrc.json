{
	"arrowParens": "always",
	"bracketSameLine": true,
	"bracketSpacing": true,
	"jsxSingleQuote": false,
	"printWidth": 90,
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": true,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true,
	"ignorePatterns": [
		"htdocs/**",
		"__assets/_libs/data/*.html",
		"skills-lock.json",
		".claude/skills/**"
	],
	"overrides": [
		{
			"files": ["*.html"],
			"options": {
				"printWidth": 320
			}
		}
	]
}

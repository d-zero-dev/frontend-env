{
	"name": "@d-zero/scaffold",
	"version": "5.4.2",
	"description": "Frontend scaffold files of D-ZERO Co., Ltd.",
	"license": "MIT",
	"author": "D-ZERO Co., Ltd.",
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/frontend-env.git",
		"directory": "packages/@d-zero/scaffold"
	},
	"type": "module",
	"main": "package.json",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "yarn lint && kamado build",
		"build:only": "kamado build",
		"dev": "kamado server",
		"d": "yarn dev",
		"ui": "kamado ui",
		"pages": "kamado pages",
		"lint": "run-s \"lint:*\"",
		"lint:html": "npx markuplint --no-allow-warnings \"./__assets/**/*.{tsx,html}\"",
		"lint:css": "npx stylelint \"./__assets/**/*.css\" --fix",
		"lint:js": "oxlint --fix __assets",
		"lint:ts": "tsc --noEmit",
		"lint:format": "oxfmt --write \"{*,**/*}.{js,mjs,cjs,jsx,ts,tsx,css,html,json,jsonc,yaml}\"",
		"lint:spell": "npx cspell --no-progress --show-suggestions \"**\"",
		"lint:text": "npx textlint \"./__assets/**/*.html\"",
		"test": "vitest run",
		"bge": "npx @burger-editor/local",
		"print": "npx @d-zero/print -f __info/print.txt --type note",
		"skills:sync": "mkdir -p .tmp && TMPDIR=./.tmp npx skills add https://github.com/d-zero-dev/frontend-guidelines/tree/main/skills --skill '*' --agent claude-code --copy -y",
		"update": "yarn upgrade-interactive"
	},
	"dependencies": {
		"@burger-editor/css": "4.0.0-alpha.77",
		"@d-zero/custom-components": "5.4.2",
		"dialog-toggle-events-polyfill": "1.1.4",
		"invokers-polyfill": "1.0.4",
		"kiso.css": "1.2.4",
		"tslib": "2.9.1"
	},
	"devDependencies": {
		"@burger-editor/local": "4.0.0-alpha.77",
		"@d-zero/cspell-config": "6.0.0-alpha.3",
		"@d-zero/lint-staged-config": "6.0.0-alpha.3",
		"@d-zero/markuplint-config": "6.0.0-alpha.3",
		"@d-zero/oxlint-config": "6.0.0-alpha.3",
		"@d-zero/oxlint-plugin": "6.0.0-alpha.3",
		"@d-zero/stylelint-config": "6.0.0-alpha.3",
		"@d-zero/textlint-config": "6.0.0-alpha.3",
		"@d-zero/tsconfig": "2.0.0",
		"@markuplint/jsx-parser": "5.5.0",
		"@markuplint/react-spec": "5.5.0",
		"@types/node": "25.9.9",
		"@types/react": "19.3.0",
		"chrome-devtools-mcp": "1.12.0",
		"dotenv": "18.0.9",
		"husky": "9.1.7",
		"kamado": "3.0.0-alpha.5",
		"npm-run-all2": "9.0.4",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"skills": "1.7.6",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	},
	"browserslist": [
		"last 1 chrome version",
		"last 1 firefox version",
		"last 1 edge version",
		"last 1 and_chr version",
		"last 2 safari version",
		"last 2 ios_saf version"
	],
	"volta": {
		"node": "24.22.2",
		"yarn": "4.18.1"
	},
	"packageManager": "yarn@4.18.1",
	"production": {
		"host": "https://example.com",
		"siteName": "__サイト名__"
	}
}

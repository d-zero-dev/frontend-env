include /component/c-form-fieldset.pug
include /component/c-form-field.pug
include /component/c-form-input-text.pug
include /component/c-form-input-select.pug
include /component/c-form-input-checkbox.pug
include /component/c-form-input-radio.pug
include /component/c-form-input-textarea.pug
include /component/c-form-input-file.pug

.c-content-main
	// CMS要件: メールフォーム概要
	.cc-form-description
		p こちらのフォームよりご応募ください。記入いただいた内容を検討の上、弊社人事担当者よりメールにてご返信いたします。
	// CMS要件: メールフォーム概要ここまで

	form#MailMessageIndexForm.cc-form(
		action="__PATH_TO__"
		enctype="multipart/form-data"
		method="post"
		accept-charset="utf-8"
		novalidate)
		input(type="hidden" name="_method" value="POST")
		input#Token__TOKEN__(type="hidden" name="data[_Token][key]" value="__TOKEN__")
		input#MailMessageMode(type="hidden" name="data[MailMessage][mode]")
		.cc-form-field-list
			+cFormFieldset({ label: "フィールドグループ名", id: "GroupMailMessageField1", isGrouped: true, isRequired: true, attention: "注意書き" })
				+cFormField({ type: "text", id: "FieldMailMessageField1", for: "MailMessageField1", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "説明文", errorMessage: "エラーメッセージ" })
					+cFormInputText({ id: "MailMessageField1", name: "data[MailMessage][field1]", maxlength: 255, isRequired: true })
				+cFormField({ type: "text", id: "FieldMailMessageField2", for: "MailMessageField2", beforeAttachment: "", afterAttachment: "後見出し", description: "説明文", errorMessage: "エラーメッセージ" })
					+cFormInputText({ id: "MailMessageField2", name: "data[MailMessage][field2]", maxlength: 255, isRequired: true })
			+cFormFieldset({ label: "単体フィールド名", id: "GroupMailMessageField3", for: "MailMessageField3", isRequired: true, attention: "注意書き" })
				+cFormField({ type: "text", id: "FieldMailMessageField3", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "説明文", errorMessage: "エラーメッセージ" })
					+cFormInputText({ id: "MailMessageField3", name: "data[MailMessage][field3]", maxlength: 255, isRequired: true })
			+cFormFieldset({ label: "氏名", id: "GroupMailMessageName", isGrouped: true, isRequired: true })
				+cFormField({ type: "text", id: "FieldMailMessageLastName", for: "MailMessageLastName", beforeAttachment: "姓", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageLastName", name: "data[MailMessage][LastName]", isRequired: true })
				+cFormField({ type: "text", id: "FieldMailMessageFirstName", for: "MailMessageFirstName", beforeAttachment: "名", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageFirstName", name: "data[MailMessage][FirstName]", isRequired: true })
			+cFormFieldset({ label: "フリガナ", id: "GroupMessageNameKana1", isGrouped: true, isRequired: false, attention: "カタカナで入力してください" })
				+cFormField({ type: "text", id: "FieldMailMessageLastNameKana", for: "MailMessageLastNameKana", beforeAttachment: "セイ", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageLastNameKana", name: "data[MailMessage][LastNameKana]", isRequired: true })
				+cFormField({ type: "text", id: "FieldMailMessageFirstNameKana", for: "MailMessageFirstNameKana", beforeAttachment: "メイ", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageFirstNameKana", name: "data[MailMessage][FirstNameKana]", isRequired: true })
			+cFormFieldset({ label: "住所", id: "GroupMessageZip", isGrouped: true, isRequired: false })
				+cFormField({ type: "text", id: "FieldMessageZip", for: "MailMessageZip", beforeAttachment: "〒", afterAttachment: "", description: "ハイフンを除く半角数字で入力してください", errorMessage: "" })
					+cFormInputText({ id: "MailMessageZip", name: "data[MailMessage][zip]", maxlength: 8, size: 10, isRequired: false })
				+cFormField({ type: "select", id: "FieldMessageAddress1", for: "MailMessageAddress1", beforeAttachment: "都道府県", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputSelect({ id: "MailMessageAddress1", name: "data[MailMessage][address_1]", options: [{ value: "", label: "選択してください" }, ...data.prefectureOptions], isRequired: false })
				+cFormField({ type: "text", id: "FieldMessageAddress2", for: "MailMessageAddress2", beforeAttachment: "市区町村", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageAddress2", name: "data[MailMessage][address_2]", maxlength: 200, size: 30, isRequired: false })
				+cFormField({ type: "text", id: "FieldMessageAddress3", for: "MailMessageAddress3", beforeAttachment: "番地", afterAttachment: "", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageAddress3", name: "data[MailMessage][address_3]", maxlength: 200, size: 30, isRequired: false })
			// CMS要件: グループ化していない場合でも チェックボックスでは fieldset/legend の構造
			+cFormFieldset({ label: "チェックボックス単体", id: "GroupMessageCategory", isGrouped: true, isRequired: true })
				+cFormField({ type: "checkbox", id: "FieldMessageCategory", beforeAttachment: "チェックボックス前見出し", afterAttachment: "チェックボックス後見出し", description: "", errorMessage: "" })
					+cFormInputCheckbox({
	hiddenId: "MailMessageCategory",
	hiddenName: "data[MailMessage][category]",
	name: "data[MailMessage][category][]",
	options: [
		{ value: "Item1", label: "項目1", id: "MailMessageCategoryItem1" },
		{ value: "Item2", label: "項目2", id: "MailMessageCategoryItem2" },
		{ value: "Item3", label: "項目3", id: "MailMessageCategoryItem3" },
	],
})
			+cFormFieldset({ label: "チェックボックス", id: "GroupMessageContents", isGrouped: true, isRequired: true, attention: "注意書き" })
				+cFormField({ type: "checkbox", id: "FieldMessageContents", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputCheckbox({
	hiddenId: "MailMessageField4",
	hiddenName: "data[MailMessage][contents]",
	name: "data[MailMessage][contents][]",
	options: [
		{ value: "1", label: "生麦生米生卵", id: "MailMessageField41" },
		{ value: "2", label: "赤パジャマ黄パジャマ茶パジャマ", id: "MailMessageField42" },
		{ value: "3", label: "青巻紙赤巻紙黄巻紙", id: "MailMessageField43" },
		{ value: "4", label: "隣の客はよく柿食う客だ", id: "MailMessageField44" },
		{ value: "5", label: "かえるぴょこぴょこ3ぴょこぴょこ あわせてぴょこぴょこ6ぴょこぴょこ", id: "MailMessageField45" },
		{ value: "6", label: "東京特許許可局許可局長", id: "MailMessageField46" },
		{ value: "7", label: "その他", id: "MailMessageField47" },
	],
})
				+cFormField({ type: "text", id: "FieldMessageContentsOther", for: "MailMessageContentsOther", beforeAttachment: "その他", afterAttachment: "後見出し", description: "その他を選択された場合は内容をご入力ください。", errorMessage: "" })
					+cFormInputText({ id: "MailMessageContentsOther", name: "data[MailMessage][contents_other]", maxlength: 255, size: 30, isRequired: false })
			+cFormFieldset({ label: "電話番号", id: "GroupMessageTel", for: "MailMessageTel", isRequired: false, attention: "注意書き" })
				+cFormField({ type: "text", id: "FieldMessageTel", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageTel", name: "data[MailMessage][tel]", maxlength: 13, size: 15, isRequired: false })
			+cFormFieldset({ label: "メールアドレス", id: "GroupMessageEmail1", for: "MailMessageEmail1", isRequired: true, attention: "注意書き" })
				+cFormField({ type: "text", id: "FieldMessageEmail1", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputText({ id: "MailMessageEmail1", name: "data[MailMessage][email_1]", maxlength: 255, size: 30, isRequired: false })
			+cFormFieldset({ label: "生まれ年", id: "GroupMessageBirth", for: "MailMessageBirth", isRequired: true, attention: "注意書き" })
				+cFormField({ type: "select", id: "FieldMessageBirth", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputSelect({ id: "MailMessageBirth", name: "data[MailMessage][birth]", options: [{ value: "", label: "選択してください" }, ...data.birthYearOptions], isRequired: false })
			+cFormFieldset({ label: "性別", id: "GroupMessageSex", isGrouped: true, isRequired: false, attention: "注意書き" })
				+cFormField({ type: "radio", id: "FieldMessageSex", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputRadio({
	hiddenId: "MailMessageSex_",
	name: "data[MailMessage][sex]",
	options: [
		{ value: "1", label: "男性", id: "MailMessageSex1" },
		{ value: "2", label: "女性", id: "MailMessageSex2" },
	],
	isRequired: false,
})
			+cFormFieldset({ label: "テキストエリア", id: "GroupMessageMessage", for: "MailMessageMessage", isRequired: false, attention: "注意書き" })
				+cFormField({ type: "textarea", id: "FieldMessageMessage", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputTextarea({ id: "MailMessageMessage", name: "data[MailMessage][message]", rows: 10, cols: null, isRequired: false })
			+cFormFieldset({ label: "テキストエリア", id: "GroupMessageMessage2", for: "MailMessageMessage2", isRequired: false, attention: "注意書き" })
				+cFormField({ type: "textarea", id: "FieldMessageMessage2", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputTextarea({ id: "MailMessageMessage2", name: "data[MailMessage][message2]", rows: 10, cols: 20, isRequired: false })
			+cFormFieldset({ label: "ファイル添付", id: "GroupMessageFile", for: "MailMessageFile", isRequired: false, attention: "注意書き" })
				+cFormField({ type: "file", id: "FieldMessageFile", beforeAttachment: "前見出し", afterAttachment: "後見出し", description: "", errorMessage: "" })
					+cFormInputFile({ id: "MailMessageFile", name: "data[MailMessage][File]", isRequired: false })
		.cc-form-agreement
			p
				| 送信前に
				a(href="__PATH_TO__") 個人情報保護方針
				| をご確認ください。
		.cc-form-submit
			button#BtnMessageConfirm(type="submit"): span 送信内容を確認
		input#TokenFields__TOKEN(type="hidden" name="data[_Token][fields]" value="__TOKEN__")
		input#TokenUnlocked__TOKEN(
			type="hidden"
			name="data[_Token][unlocked]"
			value="__TOKEN__")

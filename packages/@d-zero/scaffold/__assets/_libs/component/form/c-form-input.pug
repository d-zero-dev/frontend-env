mixin cFormInputText(params = {})
	-
		const props = Object.assign({ id: null, name: null, maxlength: null, size: null, isRequired: false }, params);
	input.c-form-input-text(
		type="text"
		name=props.name
		maxlength=props.maxlength
		size=props.size
		required=props.isRequired
		id=props.id)

mixin cFormInputSelect(params = {})
	-
		const props = Object.assign({ id: null, name: null, options: [], isRequired: false }, params);
	select.c-form-input-select(name=props.name required=props.isRequired id=props.id)
		each option in props.options
			option(value=option.value)= option.label

//- checkbox には required を出力しない（各 input に付くと「全項目チェック必須」の挙動になるため。
	「1つ以上選択必須」の検証はサーバー側の責務）
	options の各要素は { value, label, id }
mixin cFormInputCheckbox(params = {})
	-
		const props = Object.assign({ hiddenId: null, hiddenName: null, name: null, options: [] }, params);
	//- 未選択時にもキーが送信されるようにするための hidden（CMS 仕様）
	.c-form-input-checkbox
		input.c-form-input-checkbox__hidden(
			type="hidden"
			name=props.hiddenName
			value
			id=props.hiddenId)
		each option in props.options
			.c-form-input-checkbox__item
				input(type="checkbox" name=props.name value=option.value id=option.id)
				label(for=option.id) #{ option.label }

//- options の各要素は { value, label, id }。hidden と各 radio は同じ name を共有するため
	hidden 側は id（hiddenId）のみ受け取る
mixin cFormInputRadio(params = {})
	-
		const props = Object.assign({ hiddenId: null, name: null, options: [], isRequired: false }, params);
	//- 未選択時にもキーが送信されるようにするための hidden（CMS 仕様）
	.c-form-input-radio
		input.c-form-input-radio__hidden(type="hidden" name=props.name value id=props.hiddenId)
		each option in props.options
			.c-form-input-radio__item
				span
					input(
						type="radio"
						name=props.name
						required=props.isRequired
						value=option.value
						id=option.id)
					label(for=option.id) #{ option.label }

mixin cFormInputTextarea(params = {})
	-
		const props = Object.assign({ id: null, name: null, rows: null, cols: null, isRequired: false }, params);
	textarea.c-form-input-textarea(
		name=props.name
		rows=props.rows
		cols=props.cols
		required=props.isRequired
		id=props.id)

mixin cFormInputFile(params = {})
	-
		const props = Object.assign({ id: null, name: null, isRequired: false }, params);
	input.c-form-input-file(name=props.name type="file" required=props.isRequired id=props.id)

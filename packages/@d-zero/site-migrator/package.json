{
	"name": "@d-zero/site-migrator",
	"version": "5.1.1-alpha.1",
	"description": "Website migration toolkit driven by a .nitpicker archive",
	"repository": {
		"type": "git",
		"url": "https://github.com/d-zero-dev/frontend-env.git",
		"directory": "packages/@d-zero/site-migrator"
	},
	"author": "D-ZERO Co., Ltd.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"dz-migrate": "./dist/cli.js"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json",
		"dev": "tsc --watch --project tsconfig.build.json",
		"test": "vitest",
		"test:run": "vitest run"
	},
	"files": [
		"dist"
	],
	"dependencies": {
		"@burger-editor/blocks": "4.0.0-alpha.70",
		"@burger-editor/core": "4.0.0-alpha.70",
		"@d-zero/anatomist": "0.3.0",
		"@d-zero/dealer": "1.10.2",
		"@d-zero/shared": "0.22.2",
		"@nitpicker/crawler": "0.11.0",
		"@nitpicker/query": "0.15.0",
		"js-yaml": "4.3.1",
		"jsdom": "30.0.1",
		"parse5": "8.0.1",
		"parse5-html-rewriting-stream": "8.0.1",
		"puppeteer": "25.3.0"
	},
	"devDependencies": {
		"@types/js-yaml": "4.0.9",
		"@types/jsdom": "28.0.3",
		"@types/node": "25.9.5"
	}
}
